{
  "name": "@thomasfosterau/effect-loco-swiftui",
  "version": "0.0.0",
  "description": "effect-loco target that emits SwiftUI views.",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-loco/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-loco.git",
    "directory": "packages/loco-swiftui"
  },
  "license": "MIT",
  "sideEffects": [],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./internal/*": null,
    "./*/index": null
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json && pnpm babel",
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "check": "tsc -b tsconfig.json",
    "test": "vitest",
    "coverage": "vitest --coverage"
  },
  "dependencies": {
    "@thomasfosterau/effect-codegen": "workspace:^",
    "@thomasfosterau/effect-codegen-swift": "workspace:^",
    "@thomasfosterau/effect-loco": "workspace:^"
  },
  "devDependencies": {
    "effect": "^4.0.7"
  },
  "peerDependencies": {
    "effect": "^4.0.7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      "./package.json": "./package.json",
      ".": "./dist/index.js",
      "./*": "./dist/*.js",
      "./internal/*": null,
      "./*/index": null
    }
  }
}
