{
  "name": "@thomasfosterau/effect-loco-swiftui",
  "version": "0.0.0",
  "description": "effect-loco target that emits SwiftUI views.",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-loco/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-loco.git",
    "directory": "packages/loco-swiftui"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "type": "module",
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./internal/*": null,
    "./*/index": null
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": "./dist/index.js",
      "./*": "./dist/*.js",
      "./internal/*": null,
      "./*/index": null
    },
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@thomasfosterau/effect-codegen": "workspace:^",
    "@thomasfosterau/effect-codegen-swift": "workspace:^",
    "@thomasfosterau/effect-loco": "workspace:^"
  },
  "devDependencies": {
    "effect": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  }
}
