{
  "name": "@thomasfosterau/effect-loco-cli",
  "version": "0.0.0",
  "description": "The effect-loco command line interface: loads component modules and emits code for configured targets.",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-loco/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-loco.git",
    "directory": "packages/loco-cli"
  },
  "bin": {
    "loco": "./src/bin.ts"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "type": "module",
  "sideEffects": [
    "./src/bin.ts",
    "./dist/bin.js"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./internal/*": null,
    "./*/index": null
  },
  "publishConfig": {
    "bin": {
      "loco": "./dist/bin.js"
    },
    "exports": {
      "./package.json": "./package.json",
      ".": "./dist/index.js",
      "./*": "./dist/*.js",
      "./internal/*": null,
      "./*/index": null
    },
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@thomasfosterau/effect-codegen": "workspace:^",
    "@thomasfosterau/effect-loco": "workspace:^"
  },
  "devDependencies": {
    "effect": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  }
}
