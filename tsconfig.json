{
  "$schema": "http://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "references": [
    {
      "path": "tsconfig.packages.json"
    }
  ],
  "include": [
    "**/vitest.*.ts",
    "./packages/*/test/**/*.ts",
    "./packages/*/test/**/*.json",
    "./scripts/**/*.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist"
  ],
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "erasableSyntaxOnly": false,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "paths": {
      "@thomasfosterau/effect-codegen": [
        "./packages/effect-codegen/src/index.ts"
      ],
      "@thomasfosterau/effect-codegen/*": [
        "./packages/effect-codegen/src/*.ts"
      ],
      "@thomasfosterau/effect-codegen-typescript": [
        "./packages/effect-codegen-typescript/src/index.ts"
      ],
      "@thomasfosterau/effect-codegen-typescript/*": [
        "./packages/effect-codegen-typescript/src/*.ts"
      ],
      "@thomasfosterau/effect-codegen-swift": [
        "./packages/effect-codegen-swift/src/index.ts"
      ],
      "@thomasfosterau/effect-codegen-swift/*": [
        "./packages/effect-codegen-swift/src/*.ts"
      ],
      "@thomasfosterau/effect-codegen-kotlin": [
        "./packages/effect-codegen-kotlin/src/index.ts"
      ],
      "@thomasfosterau/effect-codegen-kotlin/*": [
        "./packages/effect-codegen-kotlin/src/*.ts"
      ],
      "@thomasfosterau/effect-loco": [
        "./packages/effect-loco/src/index.ts"
      ],
      "@thomasfosterau/effect-loco/*": [
        "./packages/effect-loco/src/*.ts"
      ],
      "@thomasfosterau/effect-loco-cli": [
        "./packages/effect-loco-cli/src/index.ts"
      ],
      "@thomasfosterau/effect-loco-cli/*": [
        "./packages/effect-loco-cli/src/*.ts"
      ],
      "@thomasfosterau/effect-loco-react": [
        "./packages/effect-loco-react/src/index.ts"
      ],
      "@thomasfosterau/effect-loco-react/*": [
        "./packages/effect-loco-react/src/*.ts"
      ],
      "@thomasfosterau/effect-loco-svelte": [
        "./packages/effect-loco-svelte/src/index.ts"
      ],
      "@thomasfosterau/effect-loco-svelte/*": [
        "./packages/effect-loco-svelte/src/*.ts"
      ],
      "@thomasfosterau/effect-loco-swiftui": [
        "./packages/effect-loco-swiftui/src/index.ts"
      ],
      "@thomasfosterau/effect-loco-swiftui/*": [
        "./packages/effect-loco-swiftui/src/*.ts"
      ],
      "@thomasfosterau/effect-loco-uikit": [
        "./packages/effect-loco-uikit/src/index.ts"
      ],
      "@thomasfosterau/effect-loco-uikit/*": [
        "./packages/effect-loco-uikit/src/*.ts"
      ],
      "@thomasfosterau/effect-loco-compose": [
        "./packages/effect-loco-compose/src/index.ts"
      ],
      "@thomasfosterau/effect-loco-compose/*": [
        "./packages/effect-loco-compose/src/*.ts"
      ]
    },
    "plugins": [
      {
        "name": "@effect/language-service",
        "namespaceImportPackages": [],
        "includeSuggestionsInTsc": false,
        "ignoreEffectWarningsInTscExitCode": true,
        "ignoreEffectErrorsInTscExitCode": true
      }
    ]
  }
}
